# ── Single source of truth — copy this to .env ───────────────────────
# Shared API/DB settings live here. Next.js-only settings live in apps/web/.env.

# ── Database ──
# DATABASE_ENV

# ── Auth ──
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public origin the browser uses = the Next.js app
WEB_URL=http://localhost:3000
# Optional comma-separated origins for direct non-browser API clients.
CORS_ORIGINS=
# Optional comma-separated frontend origins for auth redirects.
# VERCEL_URL is added automatically by Vercel.
BETTER_AUTH_TRUSTED_ORIGINS=

# API port (Next.js proxy forwards here via API_URL)
PORT=4000
# Number of trusted reverse-proxy hops used to resolve the client IP.
TRUSTED_PROXY_HOPS=1
# Maximum JSON payload for non-auth API routes.
JSON_BODY_LIMIT=1mb

# ── Rate Limiting ──
# Max attempts per endpoint per sliding window (15 minutes by default).
RATE_LIMIT_MAX=5
# Window in seconds (900 = 15 minutes).
RATE_LIMIT_WINDOW=900
# Optional: Redis URL for distributed rate limiting (multi-instance deploys).
# Requires: npm install @nest-lab/throttler-storage-redis ioredis
# REDIS_URL=

# ── Email (set via the email-password auth provider) ──
# AUTH_PROVIDER_ENV

# ── Docker Compose (for PostgreSQL / MySQL) ──
# # PostgreSQL
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB={{DB_NAME}}
#
# # MySQL
# MYSQL_ROOT_PASSWORD=mysql
# MYSQL_DATABASE={{DB_NAME}}
